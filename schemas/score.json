{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/stonedhawk/idea-radar/schemas/score.json",
  "title": "Score",
  "description": "Rubric score for one idea (SPEC 8.4, config/rubric.yaml). Written to scores.json as {week, scores: [...]}. Every criterion needs a one-line reason. validate.py checks the total and lens rules against the rubric.",
  "type": "object",
  "required": ["idea_id", "lens", "criteria", "total"],
  "additionalProperties": false,
  "properties": {
    "idea_id": {"type": "string", "pattern": "^[0-9]{4}-W[0-9]{2}-[0-9]{2}$"},
    "lens": {"enum": ["gaming_x_ai_pm", "gaming_only", "ai_pm_only", "neither"]},
    "criteria": {
      "type": "object",
      "required": ["lens_fit", "rahul_edge", "build_size", "demo", "verifiable", "distribution"],
      "additionalProperties": false,
      "properties": {
        "lens_fit": {"$ref": "#/$defs/criterion"},
        "rahul_edge": {"$ref": "#/$defs/criterion"},
        "build_size": {"$ref": "#/$defs/criterion"},
        "demo": {"$ref": "#/$defs/criterion"},
        "verifiable": {"$ref": "#/$defs/criterion"},
        "distribution": {"$ref": "#/$defs/criterion"}
      }
    },
    "total": {"type": "number", "minimum": 0, "maximum": 100}
  },
  "$defs": {
    "criterion": {
      "type": "object",
      "required": ["score", "reason"],
      "additionalProperties": false,
      "properties": {
        "score": {"type": "integer", "minimum": 0, "maximum": 5},
        "reason": {
          "type": "string",
          "minLength": 10,
          "pattern": "^[^\\r\\n]*\\S[^\\r\\n]*$",
          "description": "One line, not blank."
        }
      }
    }
  }
}
